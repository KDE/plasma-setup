#: modules/cellular/contents/ui/main.qml:45
#, kde-format
msgid ""
"Please configure your APN below for mobile data, further information will be "
"available with your carrier."
msgstr ""
"Παρακαλούμε επιβεβαιώστε το APN σας παρακάτω για δεδομένα κινητής "
"τηλεφωνίας, περισσότερες πληροφορίες θα είναι διαθέσιμες με τον πάροχό σας."

#: modules/cellular/contents/ui/main.qml:47
#, kde-format
msgid "You are connected to the mobile network."
msgstr "Έχετε συνδεθεί σε δίκτυο κινητής."

#: modules/cellular/contents/ui/main.qml:49
#, kde-format
msgid "Please insert a SIM card into your device."
msgstr "Παρακαλώ εισάγετε κάρτα SIM στη συσκευή σας."

#: modules/cellular/contents/ui/main.qml:51
#, kde-format
msgid "Your device does not have a modem available."
msgstr "Η συσκευή σας δεν έχει διαθέσιμο μόντεμ."

#: modules/cellular/contents/ui/main.qml:63
#, kde-format
msgid "Mobile Data"
msgstr "Δεδομένα Κινητής"

#: modules/cellular/contents/ui/main.qml:109
#, kde-format
msgid "Edit"
msgstr "Επεξεργασία"

#: modules/cellular/contents/ui/main.qml:117
#, kde-format
msgid "Delete"
msgstr "Διαγραφή"

#: modules/cellular/contents/ui/main.qml:127
#, kde-format
msgid "Add APN"
msgstr "Προσθήκη APN"

#: modules/finished/contents/ui/main.qml:25
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Your device is almost ready.<nl/><nl/>After clicking <interface>Confirm</"
"interface>, the system will finish initial setup."
msgstr ""

#: modules/finished/contents/ui/main.qml:33
#, kde-format
msgctxt "%1 is the distro name"
msgid "Your device is now ready.<br /><br />Enjoy <b>%1</b>!"
msgstr "Η συσκευή σας είναι έτοιμη.<br /><br />Απολαύστε το <b>%1</b>!"

#: modules/finished/contents/ui/main.qml:42
#, kde-format
msgctxt "%1 is the distro name"
msgid ""
"Your device is now ready.<br /><br />After clicking <b>Finish</b> you will "
"be able to sign in to your new account.<br /><br />Enjoy <b>%1</b>!"
msgstr ""
"Η συσκευή σας είναι έτοιμη.<br /><br />Μόλις κάνετε κλικ στο <b>Τέλος</b> θα "
"μπορείτε να συνδεθείτε στον νέο σας λογαριασμό.<br /><br />Απολαύστε το <b>"
"%1</b>!"

#: modules/hostname/contents/ui/main.qml:96
#, kde-format
msgctxt "@info:usagetip"
msgid "What should this device be called?"
msgstr "Πώς θα λέγεται αυτή η συσκευή;"

#: modules/hostname/contents/ui/main.qml:105
#, kde-format
msgctxt "@label:textbox"
msgid "Hostname:"
msgstr "Όνομα υπολογιστή:"

#: modules/hostnameutil/hostnameutil.cpp:94
#, kde-format
msgctxt "@info"
msgid "Hostname cannot be empty."
msgstr "Το όνομα δεν μπορεί να είναι κενό."

#: modules/hostnameutil/hostnameutil.cpp:96
#, kde-format
msgctxt "@info"
msgid "Hostname cannot be “localhost” or “localhost.localdomain”."
msgstr ""
"Το όνομα υπολογιστή δεν μπορεί να είναι “localhost” ή “localhost."
"localdomain”."

#: modules/hostnameutil/hostnameutil.cpp:98
#, kde-format
msgctxt "@info"
msgid "Hostname is too long (maximum 253 characters)."
msgstr "Το όνομα υπολογιστή είναι πολύ μεγάλο (μέγιστο 253 χαρακτήρες)."

#: modules/hostnameutil/hostnameutil.cpp:100
#, kde-format
msgctxt "@info"
msgid "Hostname cannot start with a dot."
msgstr "Το όνομα υπολογιστή δεν μπορεί να αρχίζει με τελεία."

#: modules/hostnameutil/hostnameutil.cpp:102
#, kde-format
msgctxt "@info"
msgid "Hostname cannot end with a dot."
msgstr "Το όνομα υπολογιστή δεν μπορεί να τελειώνει με τελεία."

#: modules/hostnameutil/hostnameutil.cpp:104
#, kde-format
msgctxt "@info"
msgid "Hostname cannot contain consecutive dots."
msgstr "Το όνομα χρήστη δεν μπορεί να περιέχει συνεχόμενες τελείες."

#: modules/hostnameutil/hostnameutil.cpp:106
#, kde-format
msgctxt "@info"
msgid "Hostname labels cannot be empty."
msgstr "Οι ετικέτες ονόματος υπολογιστή δεν μπορούν να είναι κενές."

#: modules/hostnameutil/hostnameutil.cpp:108
#, kde-format
msgctxt "@info"
msgid "Each hostname label must be at most 63 characters."
msgstr ""
"Κάθε ετικέτα ονόματος υπολογιστή πρέπει να είναι το πολύ 63 χαρακτήρες."

#: modules/hostnameutil/hostnameutil.cpp:110
#, kde-format
msgctxt "@info"
msgid ""
"Hostnames may contain letters, numbers, and hyphens. Each label must start "
"and end with a letter or number."
msgstr ""
"Τα ονόματα υπολογιστή μπορούν να περιέχουν γράμματα, νούμερα και παύλες. "
"Κάθε ετικέτα πρέπει να ξεκινάει και να τελειώνει με γράμμα ή νούμερο."

#: modules/keyboard/contents/ui/main.qml:189
#, kde-format
msgid "Select your keyboard layout and language."
msgstr "Επιλέξτε την διάταξη και γλώσσα του πληκτρολογίου σας."

#: modules/language/contents/ui/main.qml:46
#, kde-format
