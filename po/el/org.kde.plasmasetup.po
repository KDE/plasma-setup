#: modules/account/contents/ui/main.qml:105
#, kde-format
msgid "We need a few details to complete the setup."
msgstr "Χρειαζόμαστε μερικές λεπτομέρειες για να ολοκληρώσουμε την ρύθμιση."

#: modules/account/contents/ui/main.qml:125
#, kde-format
msgctxt "@info"
msgid "This user will be an administrator."
msgstr "Αυτός ο χρήστης θα είναι ένας διαχειριστής."

#: modules/account/contents/ui/main.qml:136
#, kde-kuit-format
msgctxt "@info"
msgid ""
"This user will have administrative privileges on the system.<nl/><nl/>This "
"means that they can change system settings, install software, and access all "
"files on the system.<nl/><nl/>Choose a strong password for this user."
msgstr ""
"Αυτός ο χρήστης θα έχει δικαιώματα διαχειριστή στο σύστημα.<nl/><nl/> Αυτό "
"σημαίνει ότι μπορούν να αλλάξουν ρυθμίσεις συστήματος, να εγκαταστήσουν "
"λογισμικό και να προσπελάσουν όλα τα αρχεία στο σύστημα.<nl/><nl/> Επιλέξτε "
"έναν ισχυρό κωδικό πρόσβασης γι' αυτόν τον χρήστη."

#: modules/account/contents/ui/main.qml:151
#, kde-format
msgctxt "@label:textbox"
msgid "Full Name"
msgstr "Πλήρες όνομα"

#: modules/account/contents/ui/main.qml:176
#, kde-format
msgctxt "@label:textbox"
msgid "Username"
msgstr "Όνομα χρήστη"

#: modules/account/contents/ui/main.qml:211
#, kde-format
msgctxt "@label:textbox"
msgid "Password"
msgstr "Κωδικός πρόσβασης"

#: modules/account/contents/ui/main.qml:232
#, kde-format
msgctxt "@label:textbox"
msgid "Confirm Password"
msgstr "Επιβεβαίωση κωδικού"

#: modules/account/contents/ui/main.qml:264
#, kde-format
msgid "Passwords must match"
msgstr "Οι κωδικοί πρέπει να είναι ίδιοι"

