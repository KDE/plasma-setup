msgstr "Σκούρο θέμα"

#: modules/time/contents/ui/main.qml:42
#, kde-format
msgid "Select your time zone."
msgstr "Επιλέξτε την ζώνη ώρας σας."

#: modules/wifi/contents/ui/main.qml:75
#, kde-format
msgid "Connect to a WiFi network for network access."
msgstr "Συνδεθείτε σε δίκτυο WiFi για πρόσβαση στο διαδίκτυο."

#: modules/wifi/contents/ui/main.qml:167
#, kde-format
msgid "Connect to"
