msgstr "このデバイスの名前はなんですか？"

#: modules/hostname/contents/ui/main.qml:105
#, kde-format
msgctxt "@label:textbox"
msgid "Hostname:"
msgstr "ホスト名:"

#: modules/hostnameutil/hostnameutil.cpp:95
#, kde-format
msgctxt "@info"
msgid "Hostname cannot be empty."
msgstr "ホスト名を空白にすることはできません。"

#: modules/hostnameutil/hostnameutil.cpp:97
#, kde-format
msgctxt "@info"
msgid "Hostname cannot be “localhost” or “localhost.localdomain”."
msgstr ""
"ホスト名を \"localhost\" や \"localhost.localdomain\" にすることはできませ"
"ん。"

#: modules/hostnameutil/hostnameutil.cpp:99
#, kde-format
msgctxt "@info"
msgid "Hostname is too long (maximum 253 characters)."
msgstr "ホスト名が長すぎます。(最大 253 文字)"

#: modules/hostnameutil/hostnameutil.cpp:101
#, kde-format
msgctxt "@info"
msgid "Hostname cannot start with a dot."
msgstr "ホスト名の一文字目をドットにすることはできません。"

#: modules/hostnameutil/hostnameutil.cpp:103
#, kde-format
msgctxt "@info"
msgid "Hostname cannot end with a dot."
msgstr "ホスト名の最後の文字をドットにすることはできません。"

#: modules/hostnameutil/hostnameutil.cpp:105
#, kde-format
msgctxt "@info"
msgid "Hostname cannot contain consecutive dots."
msgstr "ホスト名ではドットを連続させることはできません。"

#: modules/hostnameutil/hostnameutil.cpp:107
#, kde-format
msgctxt "@info"
msgid "Hostname labels cannot be empty."
msgstr "ホスト名ラベルを空白にすることはできません。"

#: modules/hostnameutil/hostnameutil.cpp:109
#, kde-format
msgctxt "@info"
msgid "Each hostname label must be at most 63 characters."
msgstr "各ホスト名ラベルは最大 63 文字までです。"

#: modules/hostnameutil/hostnameutil.cpp:111
#, kde-format
msgctxt "@info"
msgid ""
"Hostnames may contain letters, numbers, and hyphens. Each label must start "
"and end with a letter or number."
msgstr ""
"ホスト名に入力できるのは、文字、数字、ハイフンです。各ラベルの最初と最後は文"
"字または数字にする必要があります。"

