#: modules/account/contents/ui/main.qml:104
#, kde-format
msgid "We need a few details to complete the setup."
msgstr "Потребно нам је још неколико података да бисмо завршили подешавање."

#: modules/account/contents/ui/main.qml:124
#, kde-format
msgctxt "@info"
msgid "This user will be an administrator."
msgstr "Овај корисник ће бити администратор."

#: modules/account/contents/ui/main.qml:135
#, kde-kuit-format
msgctxt "@info"
msgid ""
"This user will have administrative privileges on the system.<nl/><nl/>This "
"means that they can change system settings, install software, and access all "
"files on the system.<nl/><nl/>Choose a strong password for this user."
msgstr ""
"Овај корисник ће имати администраторска овлашћења на систему.<nl/><nl/>То "
"значи да може да мења системске поставке, инсталира софтвер и приступа свим "
"фајловима на систему.<nl/><nl/>Изаберите јаку лозинку за овог корисника."

